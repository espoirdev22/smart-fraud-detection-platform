pipeline {
    agent any

    environment {
        POSTGRES_USER = credentials('fraud-postgres-user')
        POSTGRES_PASSWORD = credentials('fraud-postgres-password')
        POSTGRES_DB = credentials('fraud-postgres-db')
        DATABASE_URL = credentials('fraud-database-url')
        MODEL_PATH = credentials('fraud-model-path')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test Backend') {
            agent {
                docker {
                    image 'python:3.11-slim'
                    args '--network=host'
                }
            }
            environment {
                DATABASE_URL = 'sqlite:///./test.db'
            }
            steps {
                dir('backend') {
                    sh 'pip install -r requirements.txt'
                    sh 'python -m pytest tests/ -v'
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                sh 'docker compose build'
            }
        }

        stage('Deploy') {
            steps {
                sh 'docker compose down || true'
                sh 'docker compose up -d'
            }
        }
    }

    post {
        success {
            echo 'Pipeline termine avec succes.'
        }
        failure {
            echo 'Le pipeline a echoue.'
        }
    }
}